{
  "name": "anthonybestsite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build && node scripts/copy-public.mjs",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute anthonybestsite-db --remote --file=./worker/schema.sql",
    "db:migrate:local": "wrangler d1 execute anthonybestsite-db --local --file=./worker/schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wrangler": "^3.114.17"
  }
}
