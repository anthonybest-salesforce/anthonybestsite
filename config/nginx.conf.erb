daemon off;
worker_processes <%= ENV['NGINX_WORKERS'] || 4 %>;
error_log /dev/stderr;
pid /tmp/nginx.pid;

events {
  use epoll;
  accept_mutex on;
  worker_connections 1024;
}

http {
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 512;
  gzip_proxied any;
  gzip_vary on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/font-woff2;

  server_tokens off;

  access_log /dev/stdout;
  error_log /dev/stderr;

  include mime.types;
  default_type application/octet-stream;
  sendfile on;
  tcp_nopush on;
  keepalive_timeout 65;

  server {
    listen <%= ENV['PORT'] %>;
    server_name _;
    root /app/src;
    index index.html;

    # Trust Cloudflare + Heroku proxy headers for HTTPS redirect
    # Cloudflare always sends X-Forwarded-Proto; Heroku does too
    if ($http_x_forwarded_proto != "https") {
      return 301 https://$host$request_uri;
    }

    # Security headers (Cloudflare passes these through)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Clean URLs — try file, then file.html, then directory
    location / {
      add_header Cache-Control "public, max-age=3600";
      try_files $uri $uri.html $uri/ =404;
    }

    # CSS and JS — cache 1 week; Cloudflare will also cache at edge
    location ~* \.(css|js)$ {
      add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400";
      try_files $uri =404;
    }

    # Images and fonts — cache 30 days; Cloudflare edge caches these too
    location ~* \.(jpg|jpeg|png|gif|ico|webp|svg|woff|woff2|ttf|eot)$ {
      add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400";
      try_files $uri =404;
    }

    # Custom 404
    error_page 404 /404.html;
  }
}
