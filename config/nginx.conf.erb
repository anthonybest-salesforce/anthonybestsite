daemon off;
worker_processes <%= ENV['NGINX_WORKERS'] || 4 %>;
error_log /dev/stderr;
pid /tmp/nginx.pid;

events {
  use epoll;
  accept_mutex on;
  worker_connections 1024;
}

http {
  gzip on;
  gzip_comp_level 2;
  gzip_min_length 512;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  server_tokens off;

  access_log /dev/stdout;
  error_log /dev/stderr;

  include mime.types;
  default_type application/octet-stream;
  sendfile on;

  server {
    listen <%= ENV['PORT'] %>;
    server_name _;
    root /app/src;
    index index.html;

    # Redirect HTTP to HTTPS in production
    if ($http_x_forwarded_proto != "https") {
      return 301 https://$host$request_uri;
    }

    # Clean URLs — try file, then file.html, then directory
    location / {
      add_header Cache-Control "public, max-age=3600";
      try_files $uri $uri.html $uri/ =404;
    }

    # CSS and JS — cache 1 week
    location ~* \.(css|js)$ {
      add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400";
      try_files $uri =404;
    }

    # Images and fonts — cache 30 days
    location ~* \.(jpg|jpeg|png|gif|ico|webp|svg|woff|woff2|ttf|eot)$ {
      add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400";
      try_files $uri =404;
    }

    # Custom 404
    error_page 404 /404.html;
  }
}
