daemon off;
worker_processes <%= ENV['NGINX_WORKERS'] || 4 %>;
error_log /dev/stderr;
pid /tmp/nginx.pid;

events {
  use epoll;
  accept_mutex on;
  worker_connections 1024;
}

http {
  # ── Compression ──────────────────────────────────────────────────────────
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 512;
  gzip_proxied any;
  gzip_vary on;
  gzip_types
    text/plain
    text/css
    application/javascript
    application/json
    image/svg+xml
    application/font-woff2;

  # ── Core ─────────────────────────────────────────────────────────────────
  server_tokens off;
  access_log /dev/stdout;
  error_log /dev/stderr;
  include mime.types;
  default_type application/octet-stream;
  sendfile on;
  tcp_nopush on;
  keepalive_timeout 65;

  # Never leak the internal Heroku port in redirects
  port_in_redirect off;
  absolute_redirect off;

  server {
    listen <%= ENV['PORT'] %>;
    server_name _;
    root /app/src;
    index index.html;

    # ── HTTPS enforcement ─────────────────────────────────────────────────
    # Heroku (and Cloudflare if added later) set X-Forwarded-Proto
    if ($http_x_forwarded_proto != "https") {
      return 301 https://$host$request_uri;
    }

    # ── Security headers ──────────────────────────────────────────────────
    # NOTE: nginx add_header is NOT inherited by location blocks that define
    # their own add_header directives. Headers are therefore repeated in every
    # location block below so they are always present, regardless of which
    # block matches the request.

    # ── Legacy redirects ─────────────────────────────────────────────────
    # /links was the old homepage URL before the link-in-bio redesign.
    # 301 it to the canonical homepage so bookmarks/backlinks still work
    # and search engines consolidate ranking signals onto a single URL.
    location = /links {
      add_header X-Content-Type-Options       "nosniff"                               always;
      add_header X-Frame-Options              "SAMEORIGIN"                            always;
      add_header Referrer-Policy              "strict-origin-when-cross-origin"       always;
      return 301 /;
    }

    # ── Routing ───────────────────────────────────────────────────────────
    # Try: exact file → file.html (clean URLs) → directory index.html
    # Using $uri/index.html instead of $uri/ avoids nginx issuing an
    # external trailing-slash redirect (which would break the HTTPS check).
    location / {
      add_header Cache-Control                "public, max-age=3600"                  always;
      add_header X-Content-Type-Options       "nosniff"                               always;
      add_header X-Frame-Options              "SAMEORIGIN"                            always;
      add_header Referrer-Policy              "strict-origin-when-cross-origin"       always;
      try_files $uri $uri.html $uri/index.html =404;
    }

    # CSS / JS — cache 1 week
    location ~* \.(css|js)$ {
      add_header Cache-Control                "public, max-age=604800, stale-while-revalidate=86400" always;
      add_header X-Content-Type-Options       "nosniff"                               always;
      add_header X-Frame-Options              "SAMEORIGIN"                            always;
      add_header Referrer-Policy              "strict-origin-when-cross-origin"       always;
      try_files $uri =404;
    }

    # Images / fonts — cache 30 days
    location ~* \.(jpg|jpeg|png|gif|ico|webp|svg|woff|woff2|ttf|eot)$ {
      add_header Cache-Control                "public, max-age=2592000, stale-while-revalidate=86400" always;
      add_header X-Content-Type-Options       "nosniff"                               always;
      add_header X-Frame-Options              "SAMEORIGIN"                            always;
      add_header Referrer-Policy              "strict-origin-when-cross-origin"       always;
      try_files $uri =404;
    }

    # ── Error pages ───────────────────────────────────────────────────────
    error_page 404 /404.html;
  }
}
