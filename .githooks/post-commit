#!/bin/bash
# Stamps src/index.html's <div class="version-badge"> with "v{rev-count} · {short-sha}"
# of the just-created commit, then creates a follow-up commit carrying the stamp.
# Tagged with [skip-stamp] so this hook short-circuits on its own stamp commit.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
INDEX_HTML="$REPO_ROOT/src/index.html"

# Bail during rebase / merge / cherry-pick to avoid creating dozens of stamp commits.
GIT_DIR="$(git rev-parse --git-dir)"
if [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ] \
   || [ -f "$GIT_DIR/MERGE_HEAD" ] || [ -f "$GIT_DIR/CHERRY_PICK_HEAD" ]; then
  exit 0
fi

# Don't recurse on the stamp commit we just created.
LAST_MSG="$(git log -1 --format=%B)"
case "$LAST_MSG" in
  *"[skip-stamp]"*) exit 0 ;;
esac

[ -f "$INDEX_HTML" ] || exit 0

COUNT="$(git rev-list --count HEAD)"
SHA="$(git rev-parse --short HEAD)"
EXPECTED="v${COUNT} · ${SHA}"

CURRENT="$(grep -oE 'class="version-badge">[^<]*</div>' "$INDEX_HTML" \
  | head -1 | sed -E 's|class="version-badge">([^<]*)</div>|\1|')"

if [ "$CURRENT" = "$EXPECTED" ]; then
  exit 0
fi

# In-place edit; keep portable across BSD/GNU sed via a temp backup.
sed -i.bak -E "s|<div class=\"version-badge\">[^<]*</div>|<div class=\"version-badge\">${EXPECTED}</div>|g" "$INDEX_HTML"
rm -f "$INDEX_HTML.bak"

git add "$INDEX_HTML"
git commit --no-verify -m "chore: stamp version badge ${EXPECTED} [skip-stamp]" >/dev/null

echo "Stamped: ${EXPECTED}"
